{
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.autocomplete": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  "clangd.path": "/usr/bin/clangd",
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--compile-commands-dir=${workspaceFolder}/build/aarch64-release",
    "--query-driver=/opt/linux/x86-arm/aarch64-v01c01-linux-gnu-gcc/bin/aarch64-v01c01-linux-gnu-gcc,/opt/linux/x86-arm/aarch64-v01c01-linux-gnu-gcc/bin/aarch64-v01c01-linux-gnu-g++"
  ],
  "cmake.configureOnOpen": true,
  "cmake.preset": "aarch64-release",
  "cmake.buildDirectory": "${workspaceFolder}/build/aarch64-release",
  "cmake.generator": "Ninja"
}
